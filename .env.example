# Copy to .env and adjust. Used by docker compose.
POSTGRES_USER=sharpr
POSTGRES_PASSWORD=sharpr
POSTGRES_DB=sharpr

# API
SECRET_KEY=change-me-to-a-long-random-string
ALLOW_REGISTRATION=true
# local | s3
STORAGE_BACKEND=local
# S3-compatible (MinIO, R2, S3). Only used when STORAGE_BACKEND=s3
S3_ENDPOINT_URL=
S3_BUCKET=sharpr
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
# Comma-separated origins allowed to call the API with cookies
CORS_ORIGINS=http://localhost:3000
# set true behind HTTPS
COOKIE_SECURE=false

# Web: leave empty to proxy /api through the web app (same origin, recommended).
# Set to the API's public URL only when hosting the API on a different domain.
NEXT_PUBLIC_API_URL=
