# Sharpr configuration. Copy this file to .env next to compose.yml and edit as needed.
# Every value here is optional: with the file untouched, Sharpr runs on http://localhost:3000.

# Port the app is served on.
SHARPR_PORT=3000

# Image tag to run: latest, a version like v1.0.0, or a commit sha.
SHARPR_TAG=latest

# Signs login sessions. Leave empty and a random key is generated on first start and kept in the data
# volume. Set it yourself only if you run several API instances or want to control it.
SECRET_KEY=

# Database credentials. The database is not exposed outside Docker, so the defaults are fine
# unless you publish port 5432 or share the host.
POSTGRES_USER=sharpr
POSTGRES_PASSWORD=sharpr
POSTGRES_DB=sharpr

# Set to false once you have created your accounts. The first account can always be created.
ALLOW_REGISTRATION=true

# Set to true when serving over HTTPS (behind a reverse proxy).
COOKIE_SECURE=false

# Largest recording accepted, in MB.
MAX_UPLOAD_MB=500

# Recording storage: local (the data volume) or s3 (MinIO, Cloudflare R2, AWS S3, ...).
STORAGE_BACKEND=local
S3_ENDPOINT_URL=
S3_BUCKET=sharpr
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
